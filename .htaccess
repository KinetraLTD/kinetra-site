# Kinetra site on OVH (deployed from github.com/KinetraLTD/kinetra-site).
Options -Indexes
DirectoryIndex index.html

# Only the website is public: hide the repository and the logo sources.
RedirectMatch 404 ^/(\.git|\.github|brand|README\.md|\.gitignore)(/|$)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|webp|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|css)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>
